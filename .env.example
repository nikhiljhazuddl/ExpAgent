# ══════════════════════════════════════════════════════════════════════════════
# GTM Mesh V1.5 — production environment template
# Copy to .env and fill in. NEVER commit .env.
# ══════════════════════════════════════════════════════════════════════════════

# ─── LLM ──────────────────────────────────────────────────────────────────────
LLM_PROVIDER=anthropic                 # "anthropic" | "openai"
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MODEL=claude-sonnet-4-5
MAX_CONCURRENCY=8
RUN_COST_CAP_USD=5

# ─── Supabase (Postgres + Auth + Realtime) ────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://gfpezoxueqsrotisojip.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=             # Settings → API → service_role (server-only)
SUPABASE_DB_URL=                       # Settings → Database → URI (Session mode)

# ─── Salesforce ───────────────────────────────────────────────────────────────
SALESFORCE_INSTANCE_URL=               # https://<your-domain>.my.salesforce.com
SALESFORCE_CLIENT_ID=                  # Connected App → Consumer Key
SALESFORCE_CLIENT_SECRET=              # Connected App → Consumer Secret
SALESFORCE_REFRESH_TOKEN=              # Get once via OAuth web flow

# ─── Gong ─────────────────────────────────────────────────────────────────────
GONG_BASE_URL=https://api.gong.io
GONG_ACCESS_KEY=
GONG_ACCESS_KEY_SECRET=

# ─── Fireflies ────────────────────────────────────────────────────────────────
FIREFLIES_API_KEY=

# ─── Linear ───────────────────────────────────────────────────────────────────
LINEAR_API_KEY=
LINEAR_TEAM_ID=

# ─── Pylon ────────────────────────────────────────────────────────────────────
PYLON_API_KEY=
PYLON_BASE_URL=https://api.usepylon.com

# ─── Observability ────────────────────────────────────────────────────────────
SENTRY_DSN=
RENDER_ENV=development
